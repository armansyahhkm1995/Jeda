{
  "expo": {
    "name": "Jeda",
    "slug": "jeda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "jeda",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jeda.app"
    },
    "android": {
      "package": "com.jeda.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0EB",
        "foregroundImage": "./assets/icons/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Jeda to access Face ID for secure PIN."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/adaptive-icon.png",
          "color": "#2D5A38"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee27d6f0-d978-497c-b27f-ef1fe7128c72"
      }
    }
  }
}
